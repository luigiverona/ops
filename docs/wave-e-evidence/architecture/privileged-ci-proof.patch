+#!/bin/bash
+# EXPERIMENTAL. Only called in the disposable protected CI Arch VM.
+set -euo pipefail
+id
+test "$(id -un)" = ops-ci
+test "$(id -u)" = 1000
+test "$(systemd-detect-virt --vm)" = kvm
+test "$(cat /proc/sys/kernel/hostname)" = ops-ci
+export XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-/run/user/1000}
+test -n "$XDG_RUNTIME_DIR"
+printf 'WAVE_E_PLATFORM kernel: '; uname -a
+systemctl --version
+sudo --version
+stat -fc 'WAVE_E_PLATFORM cgroup filesystem: %T' /sys/fs/cgroup
+findmnt -t cgroup2
+cat /proc/self/cgroup
+test -S "$XDG_RUNTIME_DIR/bus"
+# Inspect the existing normal SSH/PAM manager. Never enable lingering, start a
+# missing manager, or create persistent user configuration to repair this gate.
+systemctl --user is-system-running
+systemctl --user status --no-pager
+echo 'WAVE_E_PLATFORM normal SSH/PAM user manager: PASS'
+sudo -n true
+export GOENV=off GOTOOLCHAIN=local
+test "$(/opt/go1.26.7/bin/go version)" = 'go version go1.26.7 linux/amd64'
+test -z "$(/opt/go1.26.7/bin/go env GOENV)"
+test "$(/opt/go1.26.7/bin/go env GOTOOLCHAIN)" = local
+proof_dir=$(mktemp -d /tmp/ops-wave-e-root-proof.XXXXXXXX)
+trap 'rm -rf -- "$proof_dir"' EXIT
+export GOCACHE="$proof_dir/go-cache"
+/opt/go1.26.7/bin/go build -o "$proof_dir/probe" script/wave-e-root-cgroup-proof.go
+unit="ops-wave-e-root-proof-${proof_dir##*.}"
+echo "WAVE_E_PLATFORM unit: $unit.scope"
+systemd-run --user --scope --quiet --collect --unit="$unit" \
+    --property=Delegate=yes --expand-environment=no -- \
+    "$proof_dir/probe" controller "$proof_dir" "$unit.scope"
+echo 'WAVE_E_PLATFORM privileged ownership probe: PASS'
